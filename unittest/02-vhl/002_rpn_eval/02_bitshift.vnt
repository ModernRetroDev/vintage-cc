fn shutdown() {
	// turn off the system now
	_asm("   ; shut off the system immediately");
	_asm("   ldx #$42");
	_asm("   ldy #$01");
	_asm("   lda #$00");
	_asm("   jsr $FEC9");
}

fn main() {
	// declarations
	let outfile: file;
	let a:   u8  = 0b10101010;
	let b:   u8  = 0b11111111;
	let c:   u8  = 0b11110000;
	let a16: u16 = 0b1010101010101010;
	let b16: u16 = 0b1111111111111111;
	let c16: u16 = 0b1111000011110000;

	outfile.create("02_bitshift.utest");

	outfile.writeln("#-----------------------------#");
	outfile.writeln("# PRINT VALUES IN BINARY FORM #");
	outfile.writeln("#-----------------------------#");
	outfile.writeln();

	outfile.writeln("*** print out a few binary u8 values ***");
	outfile.writeln(" * a (0b10101010) = 0b{:b}", a);
	outfile.writeln(" * b (0b11111111) = 0b{:b}", b);
	outfile.writeln(" * c (0b11110000) = 0b{:b}", c);
	outfile.writeln();

	a = a 2 <<;
	outfile.writeln(" * a 2 << (0b10101000) = 0b{:b}", a);
	b = b 4 >>;
	outfile.writeln(" * b 4 >> (0b00001111) = 0b{:b}", b);
	c = c 2 >>;
	outfile.writeln(" * c 2 >> (0b00111100) = 0b{:b}", c);
	outfile.writeln();

	outfile.writeln("*** print out a few binary u16 values ***");
	outfile.writeln(" * a16 (0b1010101010101010) = 0b{:b}", a16);
	outfile.writeln(" * b16 (0b1111111111111111) = 0b{:b}", b16);
	outfile.writeln(" * c16 (0b1111000011110000) = 0b{:b}", c16);
	outfile.writeln();

	a16 = a16 4 <<;
	outfile.writeln(" * a16 4 << (0b1010101010100000) = 0b{:b}", a16);
	b16 = b16 6 >>;
	outfile.writeln(" * b16 6 >> (0b0000001111111111) = 0b{:b}", b16);
	c16 = c16 2 >>;
	outfile.writeln(" * c16 2 >> (0b0011110000111100) = 0b{:b}", c16);


	outfile.close();
	shutdown();
}

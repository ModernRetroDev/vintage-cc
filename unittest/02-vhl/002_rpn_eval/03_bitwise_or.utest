#--------------------------## TEST USAGE OF BITWISE OR ##--------------------------#*** Test bitwise_or with u8 values *** * a (0b10101010) = 0b10101010 * b (0b11110000) = 0b11110000 * a b | (0b11111010) = 0b11111010 * a 0b00001111 | (0b10101111) = 0b10101111*** Test bitwise_or with u16 values *** * a16 (0b1010101010101010) = 0b1010101010101010 * b16 (0b1111000011110000) = 0b1111000011110000 * a16 b16 | (0b1111101011111010) = 0b1111101011111010 * b16 0b0000000011111111 | (0b1010101011111111) = 0b1010101011111111
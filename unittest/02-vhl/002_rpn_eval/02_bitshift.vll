fn shutdown
   lang_asm "   ; shut off the system immediately"
   lang_asm "   ldx #$42"
   lang_asm "   ldy #$01"
   lang_asm "   lda #$00"
   lang_asm "   jsr $FEC9"
endfn

fn main
    var__file outfile
    var__u8 a
    var__u8 b
    var__u8 c
    var__u16 a16
    var__u16 b16
    var__u16 c16
    var__u8 _stk_8_0
    var__u8 _stk_8_1
    var__u16 _stk_16_0
    var__u16 _stk_16_1

    equals__u8_u8 .a 0b10101010
    equals__u8_u8 .b 0b11111111
    equals__u8_u8 .c 0b11110000
    equals__u16_u16 .a16 0b1010101010101010
    equals__u16_u16 .b16 0b1111111111111111
    equals__u16_u16 .c16 0b1111000011110000

    # outfile.create("02_bitshift.utest");
    setup__file .outfile 'w' "@:02_bitshift.utest"
    open__file .outfile

    # outfile.writeln("#-----------------------------#");
    setout__file .outfile
    print__str8 "#-----------------------------#"
    print__endl
    setout__default

    # outfile.writeln("# PRINT VALUES IN BINARY FORM #");
    setout__file .outfile
    print__str8 "# PRINT VALUES IN BINARY FORM #"
    print__endl
    setout__default

    # outfile.writeln("#-----------------------------#");
    setout__file .outfile
    print__str8 "#-----------------------------#"
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("*** print out a few binary u8 values ***");
    setout__file .outfile
    print__str8 "*** print out a few binary u8 values ***"
    print__endl
    setout__default

    # outfile.writeln(" * a (0b10101010) = 0b{:b}", a);
    setout__file .outfile
    print__str8 " * a (0b10101010) = 0b"
    print__u8_b .a
    print__endl
    setout__default

    # outfile.writeln(" * b (0b11111111) = 0b{:b}", b);
    setout__file .outfile
    print__str8 " * b (0b11111111) = 0b"
    print__u8_b .b
    print__endl
    setout__default

    # outfile.writeln(" * c (0b11110000) = 0b{:b}", c);
    setout__file .outfile
    print__str8 " * c (0b11110000) = 0b"
    print__u8_b .c
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # a = a 2 <<;
    equals__u8_u8 ._stk_8_0 .a
    equals__u8_u8 ._stk_8_1 2
    lshift__u8_n ._stk_8_0 ._stk_8_1
    equals__u8_u8 .a ._stk_8_0

    # outfile.writeln(" * a 2 << (0b10101000) = 0b{:b}", a);
    setout__file .outfile
    print__str8 " * a 2 << (0b10101000) = 0b"
    print__u8_b .a
    print__endl
    setout__default

    # b = b 4 >>;
    equals__u8_u8 ._stk_8_0 .b
    equals__u8_u8 ._stk_8_1 4
    rshift__u8_n ._stk_8_0 ._stk_8_1
    equals__u8_u8 .b ._stk_8_0

    # outfile.writeln(" * b 4 >> (0b00001111) = 0b{:b}", b);
    setout__file .outfile
    print__str8 " * b 4 >> (0b00001111) = 0b"
    print__u8_b .b
    print__endl
    setout__default

    # c = c 2 >>;
    equals__u8_u8 ._stk_8_0 .c
    equals__u8_u8 ._stk_8_1 2
    rshift__u8_n ._stk_8_0 ._stk_8_1
    equals__u8_u8 .c ._stk_8_0

    # outfile.writeln(" * c 2 >> (0b00111100) = 0b{:b}", c);
    setout__file .outfile
    print__str8 " * c 2 >> (0b00111100) = 0b"
    print__u8_b .c
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("*** print out a few binary u16 values ***");
    setout__file .outfile
    print__str8 "*** print out a few binary u16 values ***"
    print__endl
    setout__default

    # outfile.writeln(" * a16 (0b1010101010101010) = 0b{:b}", a16);
    setout__file .outfile
    print__str8 " * a16 (0b1010101010101010) = 0b"
    print__u16_b .a16
    print__endl
    setout__default

    # outfile.writeln(" * b16 (0b1111111111111111) = 0b{:b}", b16);
    setout__file .outfile
    print__str8 " * b16 (0b1111111111111111) = 0b"
    print__u16_b .b16
    print__endl
    setout__default

    # outfile.writeln(" * c16 (0b1111000011110000) = 0b{:b}", c16);
    setout__file .outfile
    print__str8 " * c16 (0b1111000011110000) = 0b"
    print__u16_b .c16
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # a16 = a16 4 <<;
    equals__u16_u16 ._stk_16_0 .a16
    equals__u16_u8 ._stk_16_1 4
    lshift__u16_n ._stk_16_0 ._stk_16_1
    equals__u16_u16 .a16 ._stk_16_0

    # outfile.writeln(" * a16 4 << (0b1010101010100000) = 0b{:b}", a16);
    setout__file .outfile
    print__str8 " * a16 4 << (0b1010101010100000) = 0b"
    print__u16_b .a16
    print__endl
    setout__default

    # b16 = b16 6 >>;
    equals__u16_u16 ._stk_16_0 .b16
    equals__u16_u8 ._stk_16_1 6
    rshift__u16_n ._stk_16_0 ._stk_16_1
    equals__u16_u16 .b16 ._stk_16_0

    # outfile.writeln(" * b16 6 >> (0b0000001111111111) = 0b{:b}", b16);
    setout__file .outfile
    print__str8 " * b16 6 >> (0b0000001111111111) = 0b"
    print__u16_b .b16
    print__endl
    setout__default

    # c16 = c16 2 >>;
    equals__u16_u16 ._stk_16_0 .c16
    equals__u16_u8 ._stk_16_1 2
    rshift__u16_n ._stk_16_0 ._stk_16_1
    equals__u16_u16 .c16 ._stk_16_0

    # outfile.writeln(" * c16 2 >> (0b0011110000111100) = 0b{:b}", c16);
    setout__file .outfile
    print__str8 " * c16 2 >> (0b0011110000111100) = 0b"
    print__u16_b .c16
    print__endl
    setout__default

    close__file .outfile
    # shutdown();
    call shutdown

endfn


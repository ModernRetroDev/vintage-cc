    setout__default

    # outfile.writeln("------------------------");
    setout__file .outfile
    print__str8 "------------------------"
    print__endl
    setout__default

    # outfile.writeln("a = {}, b = {}", a, b);
    setout__file .outfile
    print__str8 "a = "
    print__u8 .a
    print__str8 ", b = "
    print__u8 .b
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # c = a b +;
    equals__u8_u8 ._stk_8_0 .a
    equals__u8_u8 ._stk_8_1 .b
    plus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 .c ._stk_8_0

    # outfile.writeln("a ({}) + b ({}) = {}", a, b, c);
    setout__file .outfile
    print__str8 "a ("
    print__u8 .a
    print__str8 ") + b ("
    print__u8 .b
    print__str8 ") = "
    print__u8 .c
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # c = a b + b + a -;
    equals__u8_u8 ._stk_8_0 .a
    equals__u8_u8 ._stk_8_1 .b
    plus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 ._stk_8_1 .b
    plus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 ._stk_8_1 .a
    minus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 .c ._stk_8_0

    # outfile.writeln("a b + b + a - = {}", c);
    setout__file .outfile
    print__str8 "a b + b + a - = "
    print__u8 .c
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # c = a b b + + a -;
    equals__u8_u8 ._stk_8_0 .a
    equals__u8_u8 ._stk_8_1 .b
    equals__u8_u8 ._stk_8_2 .b
    plus_equals__u8_u8 ._stk_8_1 ._stk_8_2
    plus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 ._stk_8_1 .a
    minus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 .c ._stk_8_0

    # outfile.writeln("a b b + + a - = {}", c);
    setout__file .outfile
    print__str8 "a b b + + a - = "
    print__u8 .c
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("RPN math using u16 values");
    setout__file .outfile
    print__str8 "RPN math using u16 values"
    print__endl
    setout__default

    # outfile.writeln("-------------------------");
    setout__file .outfile
    print__str8 "-------------------------"
    print__endl
    setout__default

    # outfile.writeln("d = {}, e = {}", d, e);
    setout__file .outfile
    print__str8 "d = "
    print__u16 .d
    print__str8 ", e = "
    print__u16 .e
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # f = d e +;
    equals__u16_u16 ._stk_16_0 .d
    equals__u16_u16 ._stk_16_1 .e
    plus_equals__u16_u16 ._stk_16_0 ._stk_16_1
    equals__u16_u16 .f ._stk_16_0

    # outfile.writeln("d e + = {}", f);
    setout__file .outfile
    print__str8 "d e + = "

fn shutdown
   lang_asm "   ; shut off the system immediately"
   lang_asm "   ldx #$42"
   lang_asm "   ldy #$01"
   lang_asm "   lda #$00"
   lang_asm "   jsr $FEC9"
endfn

fn main
    var__u8 a
    var__u8 b
    var__u8 c
    var__u16 d
    var__u16 e
    var__u16 f
    var__file outfile
    var__u8 _stk_8_0
    var__u8 _stk_8_1
    var__u8 _stk_8_2
    var__u16 _stk_16_0
    var__u16 _stk_16_1
    var__u16 _stk_16_2

    equals__u8_u8 .a 5
    equals__u8_u8 .b 7
    equals__u8_u8 .c 0
    equals__u16_u16 .d 1000
    equals__u16_u16 .e 500
    equals__u16_u16 .f 0

    # outfile.create("01_rpn_eval.utest");
    setup__file .outfile 'w' "@:01_rpn_eval.utest"
    open__file .outfile

    # outfile.writeln("#-------------------------------------#");
    setout__file .outfile
    print__str8 "#-------------------------------------#"
    print__endl
    setout__default

    # outfile.writeln("# TEST OUT RPN EVALUATION (I.E. MATH) #");
    setout__file .outfile
    print__str8 "# TEST OUT RPN EVALUATION (I.E. MATH) #"
    print__endl
    setout__default

    # outfile.writeln("#-------------------------------------#");
    setout__file .outfile
    print__str8 "#-------------------------------------#"
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("RPN math using u8 values");

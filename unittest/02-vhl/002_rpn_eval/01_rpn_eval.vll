    setout__default

    # outfile.writeln("----------------------------");
    setout__file .outfile
    print__str8 "----------------------------"
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # f = d e a + +;
    equals__u16_u16 ._stk_16_0 .d
    equals__u16_u16 ._stk_16_1 .e
    equals__u16_u8 ._stk_16_2 .a
    plus_equals__u16_u16 ._stk_16_1 ._stk_16_2
    plus_equals__u16_u16 ._stk_16_0 ._stk_16_1
    equals__u16_u16 .f ._stk_16_0

    # outfile.writeln("d e a + + = {}", f);
    setout__file .outfile
    print__str8 "d e a + + = "
    print__u16 .f
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    close__file .outfile
    # shutdown();
    call shutdown

endfn


    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # f = d d e + +;
    equals__u16_u16 ._stk_16_0 .d
    equals__u16_u16 ._stk_16_1 .d
    equals__u16_u16 ._stk_16_2 .e
    plus_equals__u16_u16 ._stk_16_1 ._stk_16_2
    plus_equals__u16_u16 ._stk_16_0 ._stk_16_1
    equals__u16_u16 .f ._stk_16_0

    # outfile.writeln("d d e + + = {}", f);
    setout__file .outfile
    print__str8 "d d e + + = "
    print__u16 .f
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("RPN math using u8/u16 values");
    setout__file .outfile
    print__str8 "RPN math using u8/u16 values"

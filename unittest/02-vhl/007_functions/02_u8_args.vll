fn shutdown
   lang_asm "   ; shut off the system immediately"
   lang_asm "   ldx #$42"
   lang_asm "   ldy #$01"
   lang_asm "   lda #$00"
   lang_asm "   jsr $FEC9"
endfn

fn print_sum
    var__u8 _arg_0__a
    var__u8 _arg_1__b
    ptr__file _arg_2__outfile
    var__u8 combined
    var__u8 _stk_8_0
    var__u8 _stk_8_1

    equals__u8_u8 .combined 0

    # combined = a b +;
    equals__u8_u8 ._stk_8_0 ._arg_0__a
    equals__u8_u8 ._stk_8_1 ._arg_1__b
    plus_equals__u8_u8 ._stk_8_0 ._stk_8_1
    equals__u8_u8 .combined ._stk_8_0

    # outfile.writeln("{} + {} = {}", a, b, combined);
    setout__file ._arg_2__outfile
    print__u8 ._arg_0__a
    print__str8 " + "
    print__u8 ._arg_1__b
    print__str8 " = "
    print__u8 .combined
    print__endl
    setout__default

endfn


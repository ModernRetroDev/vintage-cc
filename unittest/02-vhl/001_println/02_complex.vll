fn shutdown
   lang_asm "   ; shut off the system immediately"
   lang_asm "   ldx #$42"
   lang_asm "   ldy #$01"
   lang_asm "   lda #$00"
   lang_asm "   jsr $FEC9"
endfn

fn main
    var__bool bool_false
    var__bool bool_true
    var__file outfile

    equals__bool_bool .bool_false false
    equals__bool_bool .bool_true true

    setup__file .outfile 'w' "@:02_complex.utest"
    open__file .outfile
    setout__file .outfile
    # outfile.writeln("#---------------------------------------------------------#");
    print__str8 "#---------------------------------------------------------#"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("# PRINT COMPLEX LINES (STRINGS WITH LITERALS & VARIABLES) #");
    print__str8 "# PRINT COMPLEX LINES (STRINGS WITH LITERALS & VARIABLES) #"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("#---------------------------------------------------------#");
    print__str8 "#---------------------------------------------------------#"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln();
    print__endl

    setout__file .outfile
    # outfile.writeln("The following are two bool variables (false and true):");
    print__str8 "The following are two bool variables (false and true):"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("bool_false = `{}`", bool_false);
    print__str8 "bool_false = `"
    print__bool .bool_false
    print__str8 "`"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("bool_true  = `{}`", bool_true);
    print__str8 "bool_true  = `"
    print__bool .bool_true
    print__str8 "`"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln();
    print__endl

    setout__file .outfile
    # outfile.writeln("Here are two vars on the same line:");
    print__str8 "Here are two vars on the same line:"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("bool_false = `{}`, bool_true  = `{}`", bool_false, bool_true);
    print__str8 "bool_false = `"
    print__bool .bool_false
    print__str8 "`, bool_true  = `"
    print__bool .bool_true
    print__str8 "`"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln();
    print__endl

    setout__file .outfile
    # outfile.writeln("The following shows a suppressed endline (using endl=false):");
    print__str8 "The following shows a suppressed endline (using endl=false):"
    print__endl
    setout__default

    setout__file .outfile
    # outfile.writeln("bool_false = ", endl=false);
    print__str8 "bool_false = "
    setout__default

    setout__file .outfile
    # outfile.writeln("{}", bool_false);
    print__bool .bool_false
    print__endl
    setout__default

    close__file .outfile
    # shutdown();
    call shutdown

endfn


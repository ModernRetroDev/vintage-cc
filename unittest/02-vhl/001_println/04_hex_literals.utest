#------------------------------------------------## PRINT VALUES SPECIFIED AS HEXADECIMAL LITERALS ##------------------------------------------------#*** print out a few binary u16 values*** * 0x0000     (0) :   0 * 0x0001     (1) :   1 * 0x0002     (2) :   2 * 0x0004     (4) :   4 * 0x0008     (8) :   8 * 0x0010    (16) :   16 * 0x0020    (32) :   32 * 0x0040    (64) :   64 * 0x0080   (128) :   128 * 0x0100   (256) :   256 * 0xFFFF (65535) :   65535
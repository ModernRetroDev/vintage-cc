fn shutdown
   lang_asm "   ; shut off the system immediately"
   lang_asm "   ldx #$42"
   lang_asm "   ldy #$01"
   lang_asm "   lda #$00"
   lang_asm "   jsr $FEC9"
endfn

fn main
    var__file outfile

    # outfile.create("01_shutdown.utest");
    setup__file .outfile 'w' "@:01_shutdown.utest"
    open__file .outfile

    # outfile.writeln("#-------------------------------------------------#");
    setout__file .outfile
    print__str8 "#-------------------------------------------------#"
    print__endl
    setout__default

    # outfile.writeln("# CALL A SIMPLE FUNCTION (NO ARGS, RETURN VALUES) #");
    setout__file .outfile
    print__str8 "# CALL A SIMPLE FUNCTION (NO ARGS, RETURN VALUES) #"
    print__endl
    setout__default

    # outfile.writeln("#-------------------------------------------------#");
    setout__file .outfile
    print__str8 "#-------------------------------------------------#"
    print__endl
    setout__default

    # outfile.writeln();
    setout__file .outfile
    print__endl
    setout__default

    # outfile.writeln("About to shut down the system!!!");
    setout__file .outfile
    print__str8 "About to shut down the system!!!"
    print__endl
    setout__default

    close__file .outfile
    # shutdown();
    call shutdown

endfn


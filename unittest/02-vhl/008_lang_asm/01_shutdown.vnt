fn shutdown() {
	// turn off the system now
	_asm("   ; shut off the system immediately");
	_asm("   ldx #$42");
	_asm("   ldy #$01");
	_asm("   lda #$00");
	_asm("   jsr $FEC9");
}

fn main() {
	let outfile: file;

	outfile.create("01_shutdown.utest");

	outfile.writeln("#-------------------------------------------------#");
	outfile.writeln("# CALL A SIMPLE FUNCTION (NO ARGS, RETURN VALUES) #");
	outfile.writeln("#-------------------------------------------------#");
	outfile.writeln();

	outfile.writeln("About to shut down the system!!!");

	outfile.close();
	shutdown();
}

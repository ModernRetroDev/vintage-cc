fn shutdown() {
	// turn off the system now
	_asm("   ; shut off the system immediately");
	_asm("   ldx #$42");
	_asm("   ldy #$01");
	_asm("   lda #$00");
	_asm("   jsr $FEC9");
}

fn main() {
	let outfile: file;
	let bnk_u8:  u8@  = 0xA000;
	let bnk_u16: u16@ = 0xA001;

	outfile.create("01_pointer_vars.utest");

	outfile.writeln("#-----------------------------------------------------#");
	outfile.writeln("# WRITE VALUES TO MEMORY ADDRESSES AND READ THEM BACK #");
	outfile.writeln("#-----------------------------------------------------#");
	outfile.writeln();

	// values are dereferenced by default; both when setting and getting
	bnk_u8  = 55;
	bnk_u16 = 1337;

	outfile.writeln("bnk_u8  @{} = `{}`", @bnk_u8,  bnk_u8);
	outfile.writeln("bnk_u16 @{} = `{}`", @bnk_u16, bnk_u16);
	outfile.writeln();

	// alternatively; the address can be changed as such
	outfile.writeln("*** Setting `@bnk_u8 = 0xA003` and bank_u8 = 0xFF ***");

	@bnk_u8 = 0xA003;
	bnk_u8  = 0xFF;
	outfile.writeln("bnk_u8  @{} = `0x{:X}`", @bnk_u8, bnk_u8);
	outfile.writeln();

	outfile.writeln("*** Setting `bnk_u8 = 0b10101010` ***");
	bnk_u8  = 0b10101010;
	outfile.writeln("bnk_u8  @{} = `0b{:b}`", @bnk_u8, bnk_u8);
	outfile.writeln();

	outfile.writeln("*** Setting `bnk_u16 = 0b1111000011110000` ***");
	bnk_u16  = 0b1111000011110000;
	outfile.writeln("bnk_u16  @{} = `0b{:b}`", @bnk_u16, bnk_u16);
	outfile.writeln();

	outfile.close();
	shutdown();
}

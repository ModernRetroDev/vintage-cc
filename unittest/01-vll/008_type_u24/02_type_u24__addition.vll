fn main
	# declarations
	var__file f
	var__u24 a
	var__u24 b
	var__u8  c
	var__u16 d

	setup__file  .f  'w'  "@:02_type_u24__addition.utest"
	open__file   .f 
	setout__file .f # set default output to .f

	print__str8 "#-------------------------------------#"
	print__endl
	print__str8 "# u24 addition (small u24 values)     #"
	print__endl
	print__str8 "#-------------------------------------#"
	print__endl
	print__str8 "# test out addition of u24 values < 255"
	print__endl
	print__endl

	equals__u24_u24  .a  0xF00000
	equals__u8_u8    .c  0xA

	plus_equals__u24_u8  .a  .c
	print__str8 "*** add a u8 var to a u24 var ***"
	print__endl
	print__str8 "0xF00000 + 0xA = (0xF0000A); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	equals__u24_u24  .a  0x100000
	equals__u16_u16  .d  0x0DAD

	plus_equals__u24_u16  .a  .d
	print__str8 "*** add a u16 var to a u24 var ***"
	print__endl
	print__str8 "0x100000 + 0x0DAD = (0x100DAD); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	equals__u24_u24  .a  0xA00000
	equals__u24_u24  .b  0x00CFFF

	plus_equals__u24_u24  .a  .b
	print__str8 "*** add two u24 variables together ***"
	print__endl
	print__str8 "0xA00000 + 0x00CFFF = (0xA0CFFF); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	equals__u24_u24      .a  0xA00000
	plus_equals__u24_u8  .a  0x0000FA
	print__str8 "*** add a direct u8 to a u24 var ***"
	print__endl
	print__str8 "0xA00000 + 0x0000FA = (0xA000FA); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	equals__u24_u24       .a  0xA00000
	plus_equals__u24_u16  .a  0x000111
	print__str8 "*** add a direct u16 to a u24 var ***"
	print__endl
	print__str8 "0xA00000 + 0x000111 = (0xA00111); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	equals__u24_u24       .a  0xA00000
	plus_equals__u24_u24  .a  0x000BAA
	print__str8 "*** add a direct u24 to a u24 var ***"
	print__endl
	print__str8 "0xA00000 + 0x000BAA = (0xA00BAA); 0x"
	print__u24_xx .a
	print__endl
	print__endl

	close__file .f
	shutdown # turn off the system now

endfn
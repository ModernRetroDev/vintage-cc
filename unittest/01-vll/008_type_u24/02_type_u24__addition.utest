#-------------------------------------## u24 addition (small u24 values)     ##-------------------------------------## test out addition of u24 values < 255*** add a u8 var to a u24 var ***0xF00000 + 0xA = (0xF0000A); 0xF0000A*** add a u16 var to a u24 var ***0x100000 + 0x0DAD = (0x100DAD); 0x100DAD*** add two u24 variables together ***0xA00000 + 0x00CFFF = (0xA0CFFF); 0xA0CFFF*** add a direct u8 to a u24 var ***0xA00000 + 0x0000FA = (0xA000FA); 0xA000FA*** add a direct u16 to a u24 var ***0xA00000 + 0x000111 = (0xA00111); 0xA00111*** add a direct u24 to a u24 var ***0xA00000 + 0x000BAA = (0xA00BAA); 0xA00BAA
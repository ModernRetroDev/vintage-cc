#-------------------------------------## u24 bitshift (small u24 values)     ##-------------------------------------## test out bitshift of u24 values < 255#   0 >>=   0 (0x000000): 0x000000#   2 >>=   1 (0x000001): 0x000001#   4 >>=   2 (0x000002): 0x000002#   8 >>=   4 (0x000004): 0x000004#  16 >>=   8 (0x000008): 0x000008#  32 >>=  16 (0x000010): 0x000010#  64 >>=  32 (0x000020): 0x000020# 128 >>=  64 (0x000040): 0x000040# 256 >>= 128 (0x000080): 0x000080# 510 >>= 255 (0x0000FF): 0x0000FF#-------------------------------------## u24 bitshift (mid u24 values)       ##-------------------------------------## test out bitshift of u24 values > 255#  512 >>= 256 (0x000100): 0x000100#  514 >>= 257 (0x000101): 0x000101#  516 >>= 258 (0x000102): 0x000102#  520 >>= 260 (0x000104): 0x000104#  528 >>= 264 (0x000108): 0x000108#  544 >>= 272 (0x000110): 0x000110#  576 >>= 288 (0x000120): 0x000120#  640 >>= 320 (0x000140): 0x000140#  768 >>= 384 (0x000180): 0x000180# 1022 >>= 511 (0x0001FF): 0x0001FF#-------------------------------------## u24 bitshift (large u24 values)     ##-------------------------------------## test out bitshift of u24 values > 0xFFFF0b101010101010101010101010 >> 1; (0b010101010101010101010101): 0b010101010101010101010101
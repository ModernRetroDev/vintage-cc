#-------------------------------------## u24 subtraction (small u24 values)  ##-------------------------------------#*** subtract a u8 var to a u24 var ***0xF0000A - 0xA = (0xF00000); 0xF00000*** subtract a u16 var to a u24 var ***0x100DAD - 0x0DAD = (0x100000); 0x100000*** subtract two u24 variables together ***0xA0CFFF - 0x00CFFF = (0xA00000); 0xA00000*** subtract a direct u8 to a u24 var ***0xA000FA - 0x0000FA = (0xA00000); 0xA00000*** subtract a direct u16 to a u24 var ***0xA00111 - 0x000111 = (0xA00000); 0xA00000*** subtract a direct u24 to a u24 var ***0xAC0BAA - 0x0C0BAA = (0xA00000); 0xA00000
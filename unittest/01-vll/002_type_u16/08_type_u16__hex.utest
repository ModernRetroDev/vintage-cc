#------------------------------------------## u16 specified as hexadecimal numbers     ##------------------------------------------#*** print out a few binary u16 values*** * 0x0000 (0)  :   0 * 0x0001 (1)  :   1 * 0x0002 (2)  :   2 * 0x0004 (4)  :   4 * 0x0008 (8)  :   8 * 0x0010 (16) :  16 * 0x0020 (32) :  32 * 0x0040 (64) :  64 * 0x0080 (128): 128 * 0x00FF (255): 255*** print out a few binary u16 values; no leading zeros *** * 0x0 (0)  :   0 * 0x1 (1)  :   1 * 0x2 (2)  :   2 * 0x3 (3)  :   3 * 0x4 (4)  :   4 * 0x5 (5)  :   5 * 0x6 (6)  :   6 * 0x7 (7)  :   7 * 0x8 (8)  :   8 * 0x9 (9)  :   9 * 0xA (10) :   10 * 0xB (11) :   11 * 0xC (12) :   12 * 0xD (13) :   13 * 0xE (14) :   14 * 0xF (15) :   15*** print out a few hexadecimal u16 values*** * 0x0000 (0)    :     0 * 0x0001 (1)    :     1 * 0x0002 (2)    :     2 * 0x0004 (4)    :     4 * 0x0008 (8)    :     8 * 0x0010 (16)   :    16 * 0x0020 (32)   :    32 * 0x0040 (64)   :    64 * 0x0080 (128)  :   128 * 0x0100 (256)  :   256 * 0x0200 (512)  :   512 * 0x0400 (1024) :  1024 * 0x0800 (2048) :  2048 * 0x1000 (4096) :  4096 * 0x2000 (8192) :  8192 * 0x4000 (16384): 16384 * 0x8000 (32768): 32768 * 0xFFFF (65535): 65535
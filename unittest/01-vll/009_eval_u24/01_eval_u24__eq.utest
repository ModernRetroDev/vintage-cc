#-------------------------------------## eval-eq (u24)                       ##-------------------------------------## test out comparisons of values < 0xFF10 == 5: FALSE10 == 10: TRUE10 == 15: FALSE# test out comparisons of values > 0xFF and < 0xFFFF1000 == 500: FALSE1000 == 1000: TRUE1000 == 1500: FALSE# test out comparisons of values > 0xFFFF10000000 == 5000000: FALSE10000000 == 10000000: TRUE10000000 == 15000000: FALSE#-------------------------------------## eval-neq (u24)                      ##-------------------------------------## test out comparisons of values < 0xFF10 != 5: TRUE10 != 10: FALSE10 != 15: TRUE# test out comparisons of values > 0xFF and < 0xFFFF1000 != 500: TRUE1000 != 1000: FALSE1000 != 1500: TRUE# test out comparisons of values > 0xFFFF10000000 != 5000000: TRUE10000000 != 10000000: FALSE10000000 != 15000000: TRUE
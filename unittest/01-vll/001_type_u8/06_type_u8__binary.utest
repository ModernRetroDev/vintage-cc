#------------------------------------## u8 specified as binary numbers     ##------------------------------------#*** print out a few binary u8 values*** * 0b00000000 (0)  :   0 * 0b00000001 (1)  :   1 * 0b00000010 (2)  :   2 * 0b00000100 (4)  :   4 * 0b00001000 (8)  :   8 * 0b00010000 (16) :  16 * 0b00100000 (32) :  32 * 0b01000000 (64) :  64 * 0b10000000 (128): 128 * 0b11111111 (255): 255*** print out a few binary u8 values; no leading zeros *** * 0b0       (0) :  0 * 0b1       (1) :  1 * 0b10      (2) :  2 * 0b100     (4) :  4 * 0b1000    (8) :  8 * 0b10000   (16): 16 * 0b100000  (32): 32 * 0b1000000 (64): 64
#-----------------------------------------## u8 specified as hexadecimal numbers     ##-----------------------------------------#*** print out a few binary u8 values*** * 0x00 (0)  :   0 * 0x01 (1)  :   1 * 0x02 (2)  :   2 * 0x04 (4)  :   4 * 0x08 (8)  :   8 * 0x10 (16) :  16 * 0x20 (32) :  32 * 0x40 (64) :  64 * 0x80 (128): 128 * 0xFF (255): 255*** print out a few binary u8 values; no leading zeros *** * 0x0 (0)  :   0 * 0x1 (1)  :   1 * 0x2 (2)  :   2 * 0x3 (3)  :   3 * 0x4 (4)  :   4 * 0x5 (5)  :   5 * 0x6 (6)  :   6 * 0x7 (7)  :   7 * 0x8 (8)  :   8 * 0x9 (9)  :   9 * 0xA (10) :   10 * 0xB (11) :   11 * 0xC (12) :   12 * 0xD (13) :   13 * 0xE (14) :   14 * 0xF (15) :   15
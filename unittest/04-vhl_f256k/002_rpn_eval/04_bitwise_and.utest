#---------------------------## TEST USAGE OF BITWISE AND ##---------------------------#*** Test bitwise_and with u8 values *** * a (0b10101010) = 0b10101010 * b (0b11110000) = 0b11110000 * a b &; (0b10100000) = 0b10100000 * a 0b00001111 &; (0b00001010) = 0b00001010*** Test bitwise_and with u16 values *** * a16 (0b1010101010101010) = 0b1010101010101010 * b16 (0b1111000011110000) = 0b1111000011110000 * a16 b16 &; (0b1010000010100000) = 0b1010000010100000 * b16 0b0000000011111111 | (0b0000000010101010) = 0b0000000010101010
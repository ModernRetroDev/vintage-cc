fn main() {
	let outfile: file;
	let bnk_u8:  u8@  = 0xA000;
	let bnk_u16: u16@ = 0xA001;
	let chk_u8:  u8@;
	let chk_u16: u16@;
	let std_u8:  u8;
	let std_u16: u16;

	outfile.create("out.utest");

	outfile.writeln("#-----------------------------------------------------#");
	outfile.writeln("# WRITE VALUES TO MEMORY ADDRESSES AND READ THEM BACK #");
	outfile.writeln("#-----------------------------------------------------#");
	outfile.writeln();

	outfile.writeln("Set some initial values for 0xA000 and 0xA001");
	outfile.writeln("---------------------------------------------");
	outfile.writeln();

	// values are dereferenced by default; both when setting and getting
	bnk_u8  = 55;
	bnk_u16 = 1337;

	outfile.writeln("bnk_u8  @{} = `{}`", @bnk_u8,  bnk_u8);
	outfile.writeln("bnk_u16 @{} = `{}`", @bnk_u16, bnk_u16);
	outfile.writeln();

	// // alternatively; the address can be changed as such
	// outfile.writeln("Setting `@bnk_u8 = 0xA003` and bank_u8 = 0xFF");
	// outfile.writeln();

	std_u8 = bnk_u8;
	outfile.writeln("std_u8 = bnk_u8 = {}", std_u8);

	std_u8 = bnk_u8 10 +;
	outfile.writeln("std_u8 = bnk_u8 + 10 = {}", std_u8);
	outfile.writeln();

	outfile.writeln("Directly set values using `rpn_eval` expressions");
	outfile.writeln("---------------------------------------------------");
	outfile.writeln();

	u8@:0xA008 = 0xFF;
	@chk_u8 = 0xA008;
	outfile.writeln("u8@0xA008 = 0xFF; 0x{:X}", chk_u8);
	u16@:0xA00A = 6969;
	@chk_u16 = 0xA00A;
	outfile.writeln("u16@0xA00A = 6969; {}", chk_u16);
	outfile.writeln();

	outfile.writeln("Directly access values using `rpn_eval` expressions");
	outfile.writeln("---------------------------------------------------");
	outfile.writeln();

	std_u8 = u8@:0xA000;
	outfile.writeln("std_u8 = u8@0xA000 = {}", std_u8);
	std_u8 = u8@:0xA000 10 +;
	outfile.writeln("std_u8 = u8@0xA000 + 10 = {}", std_u8);

	std_u16 = u16@:0xA001;
	outfile.writeln("std_u16 = u8@0xA001 = {}", std_u16);
	std_u16 = u16@:0xA001 200 +;
	outfile.writeln("std_u16 = u8@0xA001 + 200 = {}", std_u16);
	outfile.writeln();

	outfile.writeln("Directly access values using `if` expressions");
	outfile.writeln("---------------------------------------------");
	outfile.writeln();

	outfile.writeln("IS u8@0xA000 == 55: ... ", endl=false);
	if u8@:0xA000 55 == {
		outfile.writeln("YES");
	} else {
		outfile.writeln("NO");
	}

	outfile.writeln("IS u16@0xA001 == 1337: ... ", endl=false);
	if u16@:0xA001 1337 == {
		outfile.writeln("YES");
	} else {
		outfile.writeln("NO");
	}
	outfile.writeln();

	outfile.writeln("Directly access values using `while` expressions");
	outfile.writeln("------------------------------------------------");
	outfile.writeln();

	outfile.writeln("for (std_u8 = 0; std_u8 < u8@:0xA000; std_u8 += 10) ...");
	outfile.writeln();
	std_u8 = 0;
	while std_u8 u8@:0xA000 < {
		outfile.writeln(" * std_u8 = {}", std_u8);
		std_u8 = std_u8 10 +;
	}
	outfile.writeln(" * break");
	outfile.writeln();

	outfile.writeln("for (std_u16 = 0; std_u16 < u16@:0xA001; std_u16 += 100) ...");
	outfile.writeln();
	std_u16 = 0;
	while std_u16 u16@:0xA001 < {
		outfile.writeln(" * std_u16 = {}", std_u16);
		std_u16 = std_u16 100 +;
	}
	outfile.writeln(" * break");

	outfile.close();
}

#-----------------------------------------------------## WRITE VALUES TO MEMORY ADDRESSES AND READ THEM BACK ##-----------------------------------------------------#Set some initial values for 0xA000 and 0xA001---------------------------------------------bnk_u8  @0xA000 = `55`bnk_u16 @0xA001 = `1337`std_u8 = bnk_u8 = 55std_u8 = bnk_u8 + 10 = 65Directly set values using `rpn_eval` expressions---------------------------------------------------u8@0xA008 = 0xFF; 0xFFu16@0xA00A = 6969; 6969Directly access values using `rpn_eval` expressions---------------------------------------------------std_u8 = u8@0xA000 = 55std_u8 = u8@0xA000 + 10 = 65std_u16 = u8@0xA001 = 1337std_u16 = u8@0xA001 + 200 = 1537Directly access values using `if` expressions---------------------------------------------IS u8@0xA000 == 55: ... YESIS u16@0xA001 == 1337: ... YESDirectly access values using `while` expressions------------------------------------------------for (std_u8 = 0; std_u8 < u8@:0xA000; std_u8 += 10) ... * std_u8 = 0 * std_u8 = 10 * std_u8 = 20 * std_u8 = 30 * std_u8 = 40 * std_u8 = 50 * breakfor (std_u16 = 0; std_u16 < u16@:0xA001; std_u16 += 100) ... * std_u16 = 0 * std_u16 = 100 * std_u16 = 200 * std_u16 = 300 * std_u16 = 400 * std_u16 = 500 * std_u16 = 600 * std_u16 = 700 * std_u16 = 800 * std_u16 = 900 * std_u16 = 1000 * std_u16 = 1100 * std_u16 = 1200 * std_u16 = 1300 * break
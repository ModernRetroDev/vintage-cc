    equals__u16_u16 .d16 0b1111000011110000
    equals__u16_u16 .e16 0b0000111100001111

    # outfile.create("out.utest");
    setup__file .outfile 'w' "out.utest"
    open__file .outfile

    # outfile.writeln("#-----------------------------#");
    setout__file .outfile
    print__str8 "#-----------------------------#"
    print__endl
    setout__default

    # outfile.writeln("# PRINT VALUES IN BINARY FORM #");

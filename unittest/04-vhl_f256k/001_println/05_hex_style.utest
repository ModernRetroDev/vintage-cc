#--------------------------------------## PRINT VALUES IN A HEXADECIMAL FORMAT ##--------------------------------------#*** print out a few binary u16 values*** * 0x0000     (0) :   0x0000 * 0x0001     (1) :   0x0001 * 0x0002     (2) :   0x0002 * 0x0004     (4) :   0x0004 * 0x0008     (8) :   0x0008 * 0x0010    (16) :   0x0010 * 0x0020    (32) :   0x0020 * 0x0040    (64) :   0x0040 * 0x0080   (128) :   0x0080 * 0x0100   (256) :   0x0100 * 0xFFFF (65535) :   0xFFFF*** print a u8 and u16 initialized w/hex values*** b = 0xA1   (161);  0xA1 c = 0x10A1 (4257); 0x10A1*** print a u8 and u16 initialized w/binary values*** d = 0b11111111  (255); 0xFF e = 0b111111111 (511); 0x01FF
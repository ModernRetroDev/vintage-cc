#-----------------------------------------------## EVALUATION OF VALUES USING POINTER REFERENCES ##-----------------------------------------------#bnk_u8 address = @0xA000@bnk_u8 = 0xA100;  =>  @0xA100@bnk_u8 += 1;  =>  @0xA101if @bnk_u8 0xA500 > ;  =>  FALSEif @bnk_u8 0xA500 < ;  =>  TRUEwhile @bnk_u8 0xA10A < ; @bnk_u8 += 1; : * @bnk_u8 = @0xA101 * @bnk_u8 = @0xA102 * @bnk_u8 = @0xA103 * @bnk_u8 = @0xA104 * @bnk_u8 = @0xA105 * @bnk_u8 = @0xA106 * @bnk_u8 = @0xA107 * @bnk_u8 = @0xA108 * @bnk_u8 = @0xA109

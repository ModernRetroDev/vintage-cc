#-----------------------------------------------------## WRITE VALUES TO MEMORY ADDRESSES AND READ THEM BACK ##-----------------------------------------------------#bnk_u8  @0x0010 = `55`bnk_u16 @0x0011 = `1337`*** Setting `@bnk_u8 = 0x0013` and bank_u8 = 0xFF ***bnk_u8  @0x0013 = `0xFF`*** Setting `bnk_u8 = 0b10101010` ***bnk_u8  @0x0013 = `0b10101010`*** Setting `bnk_u16 = 0b1111000011110000` ***bnk_u16  @0x0011 = `0b1111000011110000`

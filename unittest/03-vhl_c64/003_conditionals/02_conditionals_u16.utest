#---------------------------------------------## TEST OUT CONDITIONALS (IF / ELSE IF / ELSE) ##---------------------------------------------#if 500 < 300: FALSEif 2000 - 1000 < 1500: TRUEAs variables------------if 2000 - 1000 < 1500: TRUEif / elif / else:----------------if 500 < 300; elif 300 < 500; else: TRUE (ELIF)if 300 < 500; elif 500 < 300; else: TRUE (IF)if 300 < 300; elif 300 < 300; else: FALSE (ELSE)other comparison types:-----------------------if 500 > 300: TRUEif 300 > 500: FALSEif 500 == 500: TRUEif 500 == 300: FALSEif 500 != 500: FALSEif 500 != 300: TRUEif 500 >= 300: TRUEif 500 >= 500: TRUEif 300 >= 500: FALSE

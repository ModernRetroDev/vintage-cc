#---------------------------------------------## TEST OUT CONDITIONALS (IF / ELSE IF / ELSE) ##---------------------------------------------#if 0x5 (5) < 0x3 (3): FALSEif 0x14 (20) - 0xA (10) < 0xF (15): TRUEif / elif / else:----------------if 5 < 3; elif 3 < 5; else: TRUE (ELIF)if 3 < 5; elif 5 < 3; else: TRUE (IF)if 3 < 3; elif 3 < 3; else: FALSE (ELSE)other comparison types:-----------------------if 5 > 3: TRUEif 3 > 5: FALSEif 5 == 5: TRUEif 5 == 3: FALSEif 5 != 5: FALSEif 5 != 3: TRUEif 5 >= 3: TRUEif 5 >= 5: TRUEif 3 >= 5: FALSE

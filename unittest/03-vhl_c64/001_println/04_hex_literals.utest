#------------------------------------------------## PRINT VALUES SPECIFIED AS HEXADECIMAL LITERALS ##------------------------------------------------#*** print out a few binary u16 values*** * 0x0000     (0) :   0 * 0x0001     (1) :   1 * 0x0002     (2) :   2 * 0x0004     (4) :   4 * 0x0008     (8) :   8 * 0x0010    (16) :   16 * 0x0020    (32) :   32 * 0x0040    (64) :   64 * 0x0080   (128) :   128 * 0x0100   (256) :   256 * 0xFFFF (65535) :   65535*** print a u8 and u16 initialized w/hex values*** b = 0xA1   (161);  161 c = 0x10A1 (4257); 4257*** print a u8 and u16 initialized w/binary values*** d = 0b11111111  (255); 255 e = 0b111111111 (511); 511

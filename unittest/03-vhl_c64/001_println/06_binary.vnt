fn main() {
	// declarations
	let outfile: file;
	let a:   u8  = 0b10101010;
	let b:   u8  = 0b11111111;
	let c:   u8  = 0b00000000;
	let d:   u8  = 0b11110000;
	let e:   u8  = 0b00001111;
	let a16: u16 = 0b1010101010101010;
	let b16: u16 = 0b1111111111111111;
	let c16: u16 = 0b0000000000000000;
	let d16: u16 = 0b1111000011110000;
	let e16: u16 = 0b0000111100001111;

	outfile.create("UTEST");

	outfile.writeln("#-----------------------------#");
	outfile.writeln("# PRINT VALUES IN BINARY FORM #");
	outfile.writeln("#-----------------------------#");
	outfile.writeln();

	outfile.writeln("*** print out a few binary u8 values ***");
	outfile.writeln(" * a (0b10101010) = 0b{:b}", a);
	outfile.writeln(" * b (0b11111111) = 0b{:b}", b);
	outfile.writeln(" * c (0b00000000) = 0b{:b}", c);
	outfile.writeln(" * d (0b11110000) = 0b{:b}", d);
	outfile.writeln(" * e (0b00001111) = 0b{:b}", e);
	outfile.writeln();

	outfile.writeln("*** print out a few binary u16 values ***");
	outfile.writeln(" * a16 (0b1010101010101010) = 0b{:b}", a16);
	outfile.writeln(" * b16 (0b1111111111111111) = 0b{:b}", b16);
	outfile.writeln(" * c16 (0b0000000000000000) = 0b{:b}", c16);
	outfile.writeln(" * d16 (0b1111000011110000) = 0b{:b}", d16);
	outfile.writeln(" * e16 (0b0000111100001111) = 0b{:b}", e16);
	outfile.writeln();

	outfile.close();
}

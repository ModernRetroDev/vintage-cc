#-----------------------------## PRINT VALUES IN BINARY FORM ##-----------------------------#*** print out a few binary u8 values *** * a (0b10101010) = 0b10101010 * b (0b11111111) = 0b11111111 * c (0b00000000) = 0b00000000 * d (0b11110000) = 0b11110000 * e (0b00001111) = 0b00001111*** print out a few binary u16 values *** * a16 (0b1010101010101010) = 0b1010101010101010 * b16 (0b1111111111111111) = 0b1111111111111111 * c16 (0b0000000000000000) = 0b0000000000000000 * d16 (0b1111000011110000) = 0b1111000011110000 * e16 (0b0000111100001111) = 0b0000111100001111

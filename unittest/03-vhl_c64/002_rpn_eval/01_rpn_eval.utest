#-------------------------------------## TEST OUT RPN EVALUATION (I.E. MATH) ##-------------------------------------#RPN math using u8 values------------------------a = 5, b = 7a (5) + b (7) = 12a b + b + a - = 14a b b + + a - = 14RPN math using u16 values-------------------------d = 1000, e = 500d e + = 1500d d e + + = 2500RPN math using u8/u16 values----------------------------d e a + + = 1505

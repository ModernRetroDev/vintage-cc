#-----------------------------------## TEST BITSHIFTING OF U8/U16 VALUES ##-----------------------------------#*** print out a few binary u8 values *** * a (0b10101010) = 0b10101010 * b (0b11111111) = 0b11111111 * c (0b11110000) = 0b11110000 * a 2 << (0b10101000) = 0b10101000 * b 4 >> (0b00001111) = 0b00001111 * c 2 >> (0b00111100) = 0b00111100*** print out a few binary u16 values *** * a16 (0b1010101010101010) = 0b1010101010101010 * b16 (0b1111111111111111) = 0b1111111111111111 * c16 (0b1111000011110000) = 0b1111000011110000 * a16 4 << (0b1010101010100000) = 0b1010101010100000 * b16 6 >> (0b0000001111111111) = 0b0000001111111111 * c16 2 >> (0b0011110000111100) = 0b0011110000111100
